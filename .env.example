# Copy this file to .env and fill in your real Windows user folder paths.
# docker-compose reads .env automatically — do not commit the real .env
# (it's already covered by .gitignore's env pattern, but double check).
#
# Windows paths: use forward slashes, drive letter lowercase or uppercase
# both work, e.g. C:/Users/Acer/Downloads
#
# Find your username by running `echo $env:USERNAME` in PowerShell.

DOWNLOADS_PATH=C:/Users/YourUsername/Downloads
PICTURES_PATH=C:/Users/YourUsername/Pictures
VIDEOS_PATH=C:/Users/YourUsername/Videos