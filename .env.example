# Copy this file to .env and fill in your real Windows user folder paths.
# docker-compose reads .env automatically — do not commit the real .env
# (it's already covered by .gitignore's env pattern, but double check).
#
# Windows paths: use forward slashes, drive letter lowercase or uppercase
# both work, e.g. C:/Users/Acer/Downloads
#
# Find your username by running `echo $env:USERNAME` in PowerShell.

DOWNLOADS_PATH=C:/Users/Acer/Downloads
PICTURES_PATH=C:/Users/Acer/Pictures
VIDEOS_PATH=C:/Users/Acer/Videos
# Optional AI-assisted renaming
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: send AI rename suggestions to Telegram (Approve/Skip buttons)
# instead of a Windows dialog. Get TELEGRAM_BOT_TOKEN from @BotFather and
# TELEGRAM_CHAT_ID from @userinfobot (or similar).
# TELEGRAM_ENABLED=True
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_numeric_chat_id_here
